// Example BIND zone definition for a DNSSEC-signed zone generated by update_rrsig.sh.
//
// Expected layout:
// /etc/bind/zones/external/example.com/example.com
// /etc/bind/zones/external/example.com/example.com.signed
// /etc/bind/zones/external/example.com/TLSAexample.com.key

zone "example.com" {
    type master;
    file "/etc/bind/zones/external/example.com/example.com.signed";
};
